@import "tailwindcss";

@theme {
  --color-primary: #B45309;
  --color-ink: #1C1917;
  --color-natural-bg: #FAF9F6;
  --color-natural-card: #FFFFFF;
  --color-natural-muted: #D6D3D1;
  --color-natural-secondary: #44403C;
}

body {
  background-color: #FAF9F6;
  color: #1C1917;
}

/* Custom scrollbar and selection colors */
::selection {
  background-color: #B45309;
  color: #FFFFFF;
}
